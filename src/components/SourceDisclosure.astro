---
interface Props {
	demo: 'canvas-waves' | 'line-chart' | 'price-volume' | 'leverage-decay' | 'survivorship' | 'sweetvox' | 'espresso';
	locale: 'zh-TW' | 'en';
}

const { demo, locale } = Astro.props;
const summary = locale === 'zh-TW' ? '原始碼' : 'Source';
const sources = {
	'canvas-waves': `const canvas = document.querySelector('[data-lab-demo="canvas-waves"]');
const ctx = canvas.getContext('2d');
let frame = 0;

function draw(width, height) {
  ctx.clearRect(0, 0, width, height);
  for (let layer = 0; layer < 4; layer += 1) {
    ctx.beginPath();
    const yBase = height * (0.28 + layer * 0.14);
    for (let x = 0; x <= width; x += 8) {
      const y = yBase + Math.sin(x * 0.018 + frame * 0.025 + layer * 1.7) * (16 + layer * 7);
      if (x === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.stroke();
  }
  frame += 1;
  requestAnimationFrame(() => draw(width, height));
}`,
	'line-chart': `const data = [18, 22, 19, 28, 34, 31, 42, 39, 48, 51, 47, 58];
const points = data.map((value, index) => ({
  x: 36 + (index / (data.length - 1)) * 648,
  y: 324 - ((value - Math.min(...data)) / (Math.max(...data) - Math.min(...data))) * 288,
  value,
}));

svg.addEventListener('pointermove', (event) => {
  const x = ((event.clientX - svg.getBoundingClientRect().left) / svg.clientWidth) * 720;
  const nearest = points.reduce((best, point) =>
    Math.abs(point.x - x) < Math.abs(best.x - x) ? point : best,
  );
  tooltip.textContent = nearest.value;
});`,
	'price-volume': `// 營收成長 = (1 + 量成長) x (1 + 價成長) - 1
// 已知營收成長 r 與出貨量成長 v，反解價格成長 p：
const p = (1 + r) / (1 + v) - 1;

// 兩段用同一把尺畫，才比得出誰佔多數。
// 以「量與價之中較大的絕對值」當滿格，0% 就真的畫成 0 寬。
const scale = Math.max(Math.abs(pv), Math.abs(pp), 1);
barVol.style.width = \`\${(Math.abs(pv) / scale) * 50}%\`;
barPrice.style.width = \`\${(Math.abs(pp) / scale) * 50}%\`;`,
	'leverage-decay': `// 兩倍槓桿追蹤的是「每日報酬的兩倍」，不是「期間報酬的兩倍」。
// 所以要逐日相乘，不能把整段報酬乘二。
let index = 100;
let lev = 100;
parts.forEach((pct) => {
  const r = pct / 100;
  index *= 1 + r;
  lev *= 1 + k * r;        // k = 槓桿倍數
});

// -20, 25 走三次：index 回到 100，lev 只剩 72.9。
// 少掉的 27.1 不是手續費，是波動本身。
const shortfall = index - lev;`,
	'sweetvox': `// 甜嗓：拆 MID／SIDE，女聲前移、通透、真空管暖度
// 全程在瀏覽器裡處理，不上傳。
y = norm * (tanh(k*(x + b)) - tanh(k*b))
k=0.6、b=0.18`,
	'espresso': `// 粉量 18 g、目標出杯 36 g、預浸 4 秒
// 壓力超過 9 bar 粉餅被壓得更密，多出的壓力只有一部分變成流速
Peff = pressure <= 9 ? pressure : 9 + (pressure - 9) * 0.35
// 達西定律簡化：流速 ∝ 粒徑平方 × 壓力
flow = 1.45 * (grind / 300) ** 2 * (Peff / 9)          // g/s
shotTime = 4 + 36 / flow                                 // 秒（含預浸）
// 萃取：越細表面積越大、越熱溶得越快，接觸越久越接近上限
rate = 0.0447 * (300 / grind) * Math.exp(0.045 * (temp - 93))
EYmax = 28
EY(t) = EYmax * (1 - Math.exp(-rate * t))               // t 為秒
ey = EY(shotTime)                                         // 萃取率 %
tds = ey * 18 / 36                                        // 濃度 %
// 通道效應：太細又太高壓，水會鑽出裂縫
channel = clamp((240 - grind) / 60, 0, 1) * clamp((pressure - 8.5) / 2.5, 0, 1)
eyEff = ey * (1 - 0.15 * channel)
// 酸苦：-1 = 很酸，0 = 平衡，+1 = 很苦
balance = clamp((eyEff - 20) / 4 + (temp - 93) * 0.06, -1, 1)`,
	'survivorship': `// 資料來自自建的 Norgate 資料庫（1990 年起）：
// active 3,925 檔、delisted 8,562 檔，合計 12,487 檔。
const total = D.active_count + D.delisted_count;
const CELLS = 200;                        // 200 格，一格約 62 家
const per = total / CELLS;
const deadCells = Math.round(D.delisted_count / per);   // = 137 格

// 前 137 格畫成「已消失」，其餘是「還活著」。
// 打開開關時把已消失的那些淡出——那就是多數回測工具看到的世界。
for (let i = 0; i < CELLS; i += 1) {
  html += \`<i class="\${i < deadCells ? 'sv-dead' : 'sv-alive'}"></i>\`;
}`,
};
---

<details class="source-panel">
	<summary>{summary}</summary>
	<div class="code-wrap"><button class="copy-code" type="button" data-copy-code aria-label="Copy source">Copy</button><pre><code>{sources[demo]}</code></pre></div>
</details>
