---
import type { Locale } from '../lib/site';

interface Video {
	title: string;
	summary: string;
	src: string;
	article: string;
	date: string;
	poster?: string;
	duration?: number;
	points?: string[];
}

interface Props {
	video: Video;
	locale: Locale;
	headingLevel?: 'h2' | 'h3';
}

const { video, locale, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const zh = locale === 'zh-TW';
const baseUrl = 'https://blog.getrealpha.com';
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'VideoObject',
	name: video.title,
	description: video.summary,
	...(video.poster ? { thumbnailUrl: `${baseUrl}${video.poster}` } : {}),
	uploadDate: video.date,
	contentUrl: `${baseUrl}${video.src}`,
	...(video.duration ? { duration: `PT${video.duration}S` } : {}),
	inLanguage: locale,
};
---

<article class="video-feature">
	<div class="video-wrap">
		<video controls playsinline preload="none" poster={video.poster} src={video.src}></video>
	</div>
	<div class="video-copy">
		<Heading>{video.title}</Heading>
		<p class="video-summary">{video.summary}</p>
		{video.points && video.points.length > 0 && (
			<ul>
				{video.points.map((point) => <li>{point}</li>)}
			</ul>
		)}
		<p class="video-link"><a href={video.article}>{zh ? '讀完整文章 →' : 'Read the full article →'}</a></p>
	</div>
</article>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<style>
	.video-feature {
		display: grid;
		grid-template-columns: clamp(220px, 28vw, 300px) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3rem);
	}
	.video-wrap { width: clamp(220px, 28vw, 300px); }
	video {
		display: block;
		width: 100%;
		aspect-ratio: 9 / 16;
		border-radius: 12px;
		background: #111;
	}
	.video-copy { min-width: 0; }
	h2, h3 {
		margin: 0;
		color: var(--text);
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.9rem);
		line-height: 1.3;
	}
	.video-summary {
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.7;
	}
	ul {
		margin: 1rem 0 0;
		padding-left: 1.25rem;
		color: var(--text);
	}
	li { margin-top: 0.55rem; line-height: 1.65; }
	.video-link { margin: 1.25rem 0 0; }
	.video-link a {
		color: var(--accent);
		font-family: var(--font-hand);
		font-weight: 700;
		text-decoration: none;
	}
	.video-link a:hover { text-decoration: underline; }

	@media (max-width: 719px) {
		.video-feature { grid-template-columns: 1fr; }
		.video-wrap { width: min(100%, 320px); margin-inline: auto; }
	}
</style>
