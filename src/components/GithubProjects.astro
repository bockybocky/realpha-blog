---
/**
 * GitHub 公開作品清單。資料由 scripts/sync-github-projects.mjs 在 build 前抓，
 * 只列有寫描述的 repo；抓不到就沿用上次的，抓不到又沒舊資料就整區不顯示。
 */
import data from '../data/github-projects.json';
import zhBlurbs from '../data/github-projects-zh.json';

interface Props {
	locale: 'zh-TW' | 'en';
}

const { locale } = Astro.props;
const zh = locale === 'zh-TW';
const repos = (data.repos ?? []).map((r) => {
	const zhInfo = (zhBlurbs as Record<string, { title: string; blurb: string }>)[r.name];
	return { ...r, zhTitle: zhInfo?.title ?? null, zhBlurb: zhInfo?.blurb ?? null };
});
const profile = 'https://github.com/bockybocky';
---

{repos.length > 0 && (
	<section class="section" aria-labelledby="gh-title">
		<div class="section-header">
			<h2 id="gh-title">{zh ? 'GitHub 上的公開作品' : 'Open source on GitHub'}</h2>
			<p class="muted">
				{zh
					? '寫給自己用、後來覺得別人也用得上的東西。點進去是原始碼，不是介紹頁。'
					: 'Tools built for my own use that turned out to be useful to others. Links go to the source, not a landing page.'}
			</p>
		</div>
		<div class="grid">
			{repos.map((repo) => (
				<a class="entry gh-entry" id={repo.name} href={repo.url} target="_blank" rel="noopener">
					<div class="meta">
						{repo.language && <span>{repo.language}</span>}
						{repo.stars > 0 && <span>★ {repo.stars}</span>}
					</div>
					<h3>{zh && repo.zhTitle ? repo.zhTitle : repo.name}</h3>
					{zh && repo.zhTitle && <p class="gh-slug">{repo.name}</p>}
					<p>{zh && repo.zhBlurb ? repo.zhBlurb : repo.description}</p>
				</a>
			))}
		</div>
		<p class="gh-more">
			<a href={profile} target="_blank" rel="noopener">
				{zh ? '其餘作品在 GitHub 上 →' : 'More on GitHub →'}
			</a>
		</p>
	</section>
)}

<style>
	.gh-entry h3 {
		margin: 0 0 0.15rem;
		font-size: 1.08rem;
		word-break: break-word;
	}

	/* repo 原名，放在中文名下面當小字——讀者到了 GitHub 才認得出是同一個 */
	.gh-slug {
		margin: 0 0 0.5rem;
		font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
		font-size: 0.78rem;
		color: var(--muted);
	}

	.gh-more {
		margin: 1.2rem 0 0;
		font-size: 0.92rem;
	}
</style>
