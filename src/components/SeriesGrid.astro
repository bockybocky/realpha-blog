---
// 節目系列小卡格：節目名＋篇數（首頁⑤與 /series/ 共用）
import { seriesPath, type Series } from '../lib/catalog';
import type { Locale } from '../lib/site';

interface Props {
	series: Series[];
	locale: Locale;
}

const { series, locale } = Astro.props;
---

<ul class="series-grid">
	{series.map((s) => (
		<li>
			<a class="series-card" href={seriesPath(locale, s.id)}>
				<span class="series-name">{s.name[locale]}</span>
				<span class="series-count">{locale === 'zh-TW' ? `${s.posts.length} 篇` : `${s.posts.length} posts`}</span>
			</a>
		</li>
	))}
</ul>

<style>
	.series-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
		gap: 0.75rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}
	.series-card {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
		height: 100%;
		padding: 0.85rem 1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--paper);
		text-decoration: none;
		transition: border-color 0.2s ease;
	}
	.series-card:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); }
	.series-name { font-weight: 700; line-height: 1.3; }
	.series-count { color: var(--muted); font-size: 0.88rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
</style>
