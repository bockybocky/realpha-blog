---
// 有聲文章播放器：原生 <audio>，preload="none" 不先下載；語速鈕要 JS 才顯示
import { formatDuration, type AudioInfo } from '../lib/audio';
import type { Locale } from '../lib/site';

interface Props {
	audio: AudioInfo;
	locale: Locale;
	/** 鎖定畫面顯示的標題與封面（Media Session）；沒封面就用 512 圖示 */
	title?: string;
	cover?: string;
}

const { audio, locale, title = '', cover } = Astro.props;
const artwork = cover
	? { src: cover, type: /\.png$/i.test(cover) ? 'image/png' : /\.webp$/i.test(cover) ? 'image/webp' : 'image/jpeg', sizes: '1600x900' }
	: { src: '/icons/icon-512.png', type: 'image/png', sizes: '512x512' };
const zh = locale === 'zh-TW';
const duration = formatDuration(audio.seconds);
const speeds = [1, 1.25, 1.5];
---

<section class="audio-player" aria-label={zh ? '收聽這篇' : 'Listen to this article'} data-audio-player data-pagefind-ignore data-title={title} data-artwork={JSON.stringify(artwork)}>
	<p class="audio-label">
		<span>🎧 {zh ? '收聽這篇' : 'Listen'}</span>
		{duration && <span class="audio-duration">{duration}</span>}
	</p>
	<audio controls preload="none" src={audio.src}>
		<a href={audio.src}>{zh ? '下載音檔' : 'Download audio'}</a>
	</audio>
	<div class="audio-speeds" role="group" aria-label={zh ? '語速' : 'Playback speed'} hidden>
		{speeds.map((s) => (
			<button type="button" data-speed={s} aria-pressed={s === 1 ? 'true' : 'false'}>{s}x</button>
		))}
	</div>
</section>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-audio-player]')) {
		const audio = root.querySelector('audio');
		const group = root.querySelector<HTMLElement>('.audio-speeds');
		if (!audio || !group) continue;
		const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-speed]')];
		for (const button of buttons) {
			button.addEventListener('click', () => {
				audio.playbackRate = Number(button.dataset.speed) || 1;
				for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
			});
		}
		group.hidden = false;

		// 鎖定畫面與耳機鍵控制（Media Session，2026-09-15 PWA）；瀏覽器不支援就略過
		if ('mediaSession' in navigator) {
			const session = navigator.mediaSession;
			const setPosition = () => {
				if (!Number.isFinite(audio.duration) || !('setPositionState' in session)) return;
				try {
					session.setPositionState({ duration: audio.duration, playbackRate: audio.playbackRate, position: Math.min(audio.currentTime, audio.duration) });
				} catch {
					// 部分瀏覽器在 metadata 未就緒時會丟錯，下一次事件再補
				}
			};
			const bind = () => {
				let art: MediaImage[] = [];
				try {
					const a = JSON.parse(root.dataset.artwork ?? 'null');
					if (a?.src) art = [{ ...a, src: new URL(a.src, location.href).href }];
				} catch {
					// 封面資料壞掉就不給圖
				}
				session.metadata = new MediaMetadata({ title: root.dataset.title || document.title, artist: 'Realpha', artwork: art });
				const handlers: [MediaSessionAction, MediaSessionActionHandler][] = [
					['play', () => void audio.play()],
					['pause', () => audio.pause()],
					['seekbackward', (d) => { audio.currentTime = Math.max(0, audio.currentTime - (d.seekOffset || 10)); setPosition(); }],
					['seekforward', (d) => { audio.currentTime = Math.min(audio.duration || Infinity, audio.currentTime + (d.seekOffset || 10)); setPosition(); }],
					['seekto', (d) => { if (d.seekTime != null) audio.currentTime = d.seekTime; setPosition(); }],
				];
				for (const [action, handler] of handlers) {
					try {
						session.setActionHandler(action, handler);
					} catch {
						// 不支援的動作（例如舊版 Safari 的 seekto）略過
					}
				}
			};
			audio.addEventListener('play', () => { bind(); session.playbackState = 'playing'; setPosition(); });
			audio.addEventListener('pause', () => { session.playbackState = 'paused'; });
			audio.addEventListener('ratechange', setPosition);
			audio.addEventListener('loadedmetadata', setPosition);
		}
	}
</script>

<style>
	.audio-player {
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--paper);
		padding: 0.75rem 1rem;
		display: grid;
		gap: 0.5rem;
	}
	.audio-label {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin: 0;
		font-size: 0.95rem;
		font-weight: 600;
	}
	.audio-duration {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		font-weight: 500;
	}
	.audio-player audio {
		width: 100%;
		display: block;
	}
	.audio-speeds {
		display: flex;
		gap: 0.4rem;
	}
	.audio-speeds[hidden] { display: none; }
	.audio-speeds button {
		border: 1px solid var(--line);
		border-radius: 2rem;
		padding: 0.2rem 0.75rem;
		background: var(--paper);
		color: var(--muted);
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
	}
	.audio-speeds button:hover { color: var(--text); }
	.audio-speeds button[aria-pressed='true'] {
		color: var(--accent-strong);
		background: var(--accent-tint);
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
	}
</style>
