---
// 首頁（中英共用）：標語帶＋文章總數／今日瀏覽／總瀏覽 → 最新 12 篇 → 廣告 → 熱門
// 2026-09-15 Charles「首頁功能頁面重複了」「首頁這不就重複了」：主題區塊與分類分頁籤都和導覽列重複，拿掉；三類入口只留導覽列
// 2026-09-15 Charles「節目系列不要列出來」「先不做 Podcast」「不要驗證簿了，超機械的，沒有人味」：節目、podcast、驗證簿窄帶全部拿掉
import SiteLayout from '../layouts/SiteLayout.astro';
import AdPush from './AdPush.astro';
import AdSlot from './AdSlot.astro';
import PostCard from './PostCard.astro';
import { getCatalog, type Post } from '../lib/catalog';
import { readPopular, viewsOf } from '../lib/popular';
import { withLocale, type Locale } from '../lib/site';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === 'zh-TW';
const cat = await getCatalog(locale);
const label = (post: Post) => cat.topicName(cat.topicOf(post));

const t = zh
	? {
			title: 'Realpha Blog',
			description: 'Realpha 的筆記：心法與成長、研究筆記、投資與市場。每篇最後留一件你今天就能帶走的小事。',
			tagline: '聽我陪你作研究',
			sub: '心法、研究與市場的筆記。每篇文章最後，都留一件你今天就能帶走的小事。',
			latest: '最新文章',
			more: '看更多 →',
			popular: '熱門文章',
			posts: '文章總數',
			today: '今日瀏覽',
			total: '總瀏覽',
		}
	: {
			title: 'Realpha Blog',
			description: 'Notes from Realpha: growth, research, and markets. Every post ends with one small thing you can take with you today.',
			tagline: 'Listen in while I do the research with you',
			sub: 'Notes on mindset, research and markets. Every post ends with one small thing you can take with you today.',
			latest: 'Latest posts',
			more: 'See more →',
			popular: 'Popular',
			posts: 'Posts',
			today: 'Today',
			total: 'Total views',
		};

// 全站計數器（2026-09-15 Charles「首頁的今日瀏覽／總瀏覽」）：建置時先放 scripts/site_stats.mjs 算好的數字，
// 頁面打開再抓 /stats.json（排程每 10 分鐘更新）。檔案讀不到就整行不顯示。
let stats: { today: number; total: number; date: string } | null = null;
try {
	const s = JSON.parse(readFileSync(join(process.cwd(), 'public', 'stats.json'), 'utf8'));
	if (Number(s.total) > 0) stats = { today: Number(s.today) || 0, total: Number(s.total), date: String(s.date) };
} catch {
	stats = null;
}
const numLocale = zh ? 'zh-TW' : 'en-US';

// 2026-09-15 Charles「首頁這不就重複了」：分類分頁籤與導覽列三類重複，拿掉；首頁只列最新 12 篇
const latest = cat.posts.slice(0, 12);

const bySlug = new Map(cat.posts.map((p) => [p.data.slug, p]));
const popular = readPopular()
	.filter((r) => r.lang === locale && bySlug.has(r.slug))
	.sort((a, b) => Number(b.views) - Number(a.views))
	.slice(0, 6)
	.map((r) => bySlug.get(r.slug)!);
---

<SiteLayout title={t.title} description={t.description} locale={locale} path={withLocale(locale, '/')} alternatePath={withLocale(zh ? 'en' : 'zh-TW', '/')}>
	<main class="page home" data-pagefind-ignore="all">
		<section class="home-band" aria-labelledby="home-title">
			<h1 id="home-title">{t.tagline}</h1>
			<p>{t.sub}</p>
			<p class="home-stats" data-site-stats={stats ? '' : undefined} data-locale={numLocale} data-date={stats?.date}>
				<span>{t.posts} <b>{cat.posts.length.toLocaleString(numLocale)}</b></span>
				{stats && <span>{t.today} <b data-stat="today">{stats.today.toLocaleString(numLocale)}</b></span>}
				{stats && <span>{t.total} <b data-stat="total">{stats.total.toLocaleString(numLocale)}</b></span>}
			</p>
		</section>

		<section class="home-latest" aria-labelledby="latest-title">
			<div class="home-topic-head">
				<h2 id="latest-title">{t.latest}</h2>
			</div>
			<div class="grid home-grid">
				{latest.map((post) => <PostCard post={post} locale={locale} label={label(post)} />)}
			</div>
			<p class="home-more"><a href={withLocale(locale, '/blog/')}>{t.more}</a></p>
		</section>

		<AdSlot slot="display" locale={locale} />

		{popular.length > 0 && (
			<section class="home-topic" aria-labelledby="popular-title">
				<div class="home-topic-head">
					<h2 id="popular-title">🔥 {t.popular}</h2>
				</div>
				<div class="grid home-grid">
					{popular.map((post) => <PostCard post={post} locale={locale} label={label(post)} views={viewsOf(locale, post.data.slug)} />)}
				</div>
			</section>
		)}

		<AdSlot slot="multiplex" locale={locale} />
		<AdPush />
	</main>
</SiteLayout>

<script>
	// 全站計數器：抓排程每 10 分鐘更新的 /stats.json；「今日」只在日期是台灣今天時才顯示數字，否則顯示「—」
	const statsEl = document.querySelector<HTMLElement>('[data-site-stats]');
	if (statsEl) {
		const loc = statsEl.dataset.locale || 'zh-TW';
		const todayTaipei = new Date(Date.now() + 8 * 3600 * 1000).toISOString().slice(0, 10);
		const put = (key: string, text: string) => {
			const b = statsEl.querySelector<HTMLElement>(`[data-stat="${key}"]`);
			if (b) b.textContent = text;
		};
		if (statsEl.dataset.date !== todayTaipei) put('today', '—');
		fetch(`/stats.json?t=${Date.now()}`, { cache: 'no-store' })
			.then((r) => (r.ok ? r.json() : null))
			.then((s) => {
				if (!s || !(Number(s.total) > 0)) return;
				put('total', Number(s.total).toLocaleString(loc));
				put('today', s.date === todayTaipei ? Number(s.today || 0).toLocaleString(loc) : '—');
			})
			.catch(() => {});
	}
</script>

<style>
	.home { padding-top: clamp(1.25rem, 3vw, 2rem); }

	.home-band {
		padding: 0.25rem 0 1.25rem;
		border-bottom: 1px solid var(--line);
	}
	.home-band h1 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.7rem, 4.2vw, 2.6rem);
		line-height: 1.35;
		text-wrap: balance;
	}
	.home-band p {
		margin: 0.5rem 0 0;
		color: var(--muted);
		font-family: var(--font-hand);
		font-size: 1.08rem;
		max-width: 70ch;
		text-wrap: pretty;
	}

	.home-latest { padding: 1.5rem 0 clamp(2rem, 5vw, 3rem); }

	.home-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); }
	.home-more { margin: 1.25rem 0 0; text-align: right; }
	.home-more a {
		color: var(--accent);
		font-family: var(--font-hand);
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}
	.home-more a:hover { text-decoration: underline; }

	.home-stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.5rem;
		margin: 0.9rem 0 0;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.home-stats b {
		color: var(--text);
		font-family: var(--font-hand);
		font-size: 1.15rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		margin-left: 0.25rem;
	}

	.home-topic {
		padding: clamp(2rem, 5vw, 3rem) 0;
		border-top: 1px solid var(--line);
	}
	.home-topic-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}
	.home-topic-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.4rem, 3.5vw, 1.9rem);
		line-height: 1.3;
	}
	.home-topic-head p { margin: 0.3rem 0 0; }

	@media (max-width: 560px) {
		.home-topic-head { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
	}
</style>
