---
import VideoFeature from './VideoFeature.astro';
import videos from '../data/videos.json';
import { withLocale, type Locale } from '../lib/site';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === 'zh-TW';
const items = videos
	.filter((video) => video.lang === locale)
	.sort((a, b) => b.date.localeCompare(a.date));
const [newest, ...remaining] = items;
---

{newest && (
	<section class="home-videos" aria-labelledby="videos-title">
		<div class="home-topic-head">
			<h2 id="videos-title">{zh ? '原創短影片' : 'Original shorts'}</h2>
			<a href={withLocale(locale, '/videos/')}>{zh ? '全部短影片 →' : 'All videos →'}</a>
		</div>
		<VideoFeature video={newest} locale={locale} headingLevel="h3" />
		{remaining.length > 0 && (
			<div class="video-thumbnails">
				{remaining.slice(0, 4).map((video) => video.poster && (
					<a href={withLocale(locale, '/videos/')} aria-label={video.title}>
						<img src={video.poster} alt="" loading="lazy" />
					</a>
				))}
			</div>
		)}
	</section>
)}

<style>
	.home-videos {
		padding: 1.5rem 0 clamp(2rem, 5vw, 3rem);
		border-bottom: 1px solid var(--line);
	}
	.home-topic-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}
	.home-topic-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.4rem, 3.5vw, 1.9rem);
		line-height: 1.3;
	}
	.home-topic-head a {
		color: var(--accent);
		font-family: var(--font-hand);
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}
	.home-topic-head a:hover { text-decoration: underline; }
	.video-thumbnails {
		display: flex;
		gap: 0.75rem;
		overflow-x: auto;
		margin-top: 1.5rem;
		padding-bottom: 0.25rem;
	}
	.video-thumbnails a { flex: 0 0 84px; }
	.video-thumbnails img {
		display: block;
		width: 100%;
		aspect-ratio: 9 / 16;
		object-fit: cover;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--paper);
	}

	@media (max-width: 560px) {
		.home-topic-head { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
	}
</style>
