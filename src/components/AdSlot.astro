---
// 單一廣告版位。ads.json 的 enabled 為 true、client 有值、且 slots[slot] 有值才輸出，否則什麼都不輸出。
// 保留最小高度，廣告晚到時版面不會往下跳。
import ads from '../data/ads.json';

interface Props {
	slot: 'top' | 'bottom';
	locale?: 'zh-TW' | 'en';
}

const { slot, locale = 'zh-TW' } = Astro.props;
const client = typeof ads.client === 'string' ? ads.client.trim() : '';
const slotId = String((ads.slots as Record<string, string>)[slot] ?? '').trim();
const on = ads.enabled === true && client !== '' && slotId !== '';
const label = locale === 'en' ? 'Ad' : '廣告';
---

{on && (
	<aside class={`ad-slot ad-slot-${slot}`} aria-label={label} data-pagefind-ignore>
		<p class="ad-label">{label}</p>
		<ins
			class="adsbygoogle"
			style="display:block"
			data-ad-client={client}
			data-ad-slot={slotId}
			data-ad-format="auto"
			data-full-width-responsive="true"
		></ins>
		<script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
	</aside>
)}

<style>
	.ad-slot {
		margin: 2rem 0;
		min-height: 280px;
	}

	.ad-label {
		margin: 0 0 0.35rem;
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		color: var(--muted);
	}
</style>
