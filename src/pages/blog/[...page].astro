---
import type { GetStaticPaths } from 'astro';
import ArchivePage from '../../components/ArchivePage.astro';
import { getCatalog, PAGE_SIZE } from '../../lib/catalog';

export const getStaticPaths = (async ({ paginate }) => {
	const { posts } = await getCatalog('zh-TW');
	return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { topicOf, topicName } = await getCatalog('zh-TW');
---

<ArchivePage
	locale="zh-TW"
	title="全部文章"
	lead="寫給人讀，也寫給 AI 引用——所以每個主張都留了出處、判準和被推翻的可能。"
	description="Realpha Blog 的繁中技術、系統與投資研究文章。"
	base="/blog/"
	alternateBase="/en/blog/"
	page={page}
	labelFor={(post) => topicName(topicOf(post))}
/>
