---
import AdSlot from '../../components/AdSlot.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import Giscus from '../../components/Giscus.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import VocusLink from '../../components/VocusLink.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { coverAlt, readingMinutes, relatedPosts } from '../../lib/article-extras';
import topicsData from '../../data/topics.json';
import { getBlogPosts } from '../../lib/content';
import { formatDate } from '../../lib/site';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getBlogPosts('zh-TW');
	return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post, posts } }));
}

const locale = 'zh-TW';
const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const path = `/blog/${post.data.slug}/`;
// 只有真的存在英文版才給網址——寫死會讓語言鈕指到 404
const enPosts = await getBlogPosts('en');
const alternatePath = enPosts.some((p) => p.data.slug === post.data.slug)
	? `/en/blog/${post.data.slug}/`
	: null;
const labLabels = {
	hypothesis: '假設',
	plan: '驗證計畫',
	preregisteredAt: '預註冊時間',
	result: '結果',
};
const hasPreregistration = post.data.category === 'lab' && (post.data.hypothesis || post.data.plan || post.data.preregistered_at || post.data.result);
// 2026-09-15 Charles 拍板：中文版取消「讀到一半導去方格子」的收合，全文留在本站。
// ReadMoreGate 元件保留不刪，只是這裡不再使用；方格子引流留在文末 VocusLink。

const minutes = readingMinutes(post.body ?? '', locale);
const pubText = formatDate(post.data.pubDate, locale);
const updatedText = post.data.updatedDate ? formatDate(post.data.updatedDate, locale) : null;
const showAds = post.data.category !== 'lab';
const related = relatedPosts(post, posts, 6, new Set(topicsData.series.map((s) => s.id)));
// 封面移到標題下方；內文開頭原本就嵌了同一張圖（2026-09-15 查：461 篇全是），把內文那張藏起來免得出現兩次。
const cover = post.data.cover;
const hideBodyCover = Boolean(cover && post.body?.includes(cover));
const hideCoverCss = hideBodyCover
	? `<style>.prose img[src=${JSON.stringify(cover)}]{display:none}.prose p:has(> img[src=${JSON.stringify(cover)}]:only-child){display:none}</style>`
	: '';
---

<SiteLayout
	title={post.data.title}
	description={post.data.description}
	locale={locale}
	path={path}
	alternatePath={alternatePath}
	image={post.data.ogImage}
	breadcrumbs={[{ name: '文章', path: '/blog/' }, { name: post.data.title, path }]}
	article={{
		title: post.data.title,
		description: post.data.description,
		summary: post.data.tldr,
		pubDate: post.data.pubDate,
		updatedDate: post.data.updatedDate,
		path,
		tags: post.data.tags,
		image: post.data.ogImage,
	}}
>
	<Fragment set:html={hideCoverCss} />
	<main class="page article-shell">
		<article data-pagefind-body>
			<header class="article-header">
				<div class="meta">
					<time datetime={post.data.pubDate.toISOString()}>{pubText}</time>
					<span>閱讀約 {minutes} 分鐘</span>
					<span>{post.data.category}</span>
					{updatedText && updatedText !== pubText && (
						<span>更新：<time datetime={post.data.updatedDate!.toISOString()}>{updatedText}</time></span>
					)}
				</div>
				<h1 class="article-title">{post.data.title}</h1>
				{cover && (
					<figure class="article-cover">
						<img src={cover} alt={coverAlt(post.body ?? '', cover, post.data.title)} width="1600" height="900" decoding="async" fetchpriority="high" />
					</figure>
				)}
				<p class="lead">{post.data.description}</p>
				<ul class="tag-list">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
			</header>
			<div class="prose">
				{post.data.tldr && (
					<aside class="tldr-panel" aria-labelledby="tldr-title">
						<h2 id="tldr-title">TL;DR</h2>
						<p>{post.data.tldr}</p>
					</aside>
				)}
				{hasPreregistration && (
					<aside class="preregistration-panel" aria-labelledby="preregistration-title">
						<h2 id="preregistration-title">預註冊紀錄</h2>
						<dl>
							{post.data.hypothesis && (
								<>
									<dt>{labLabels.hypothesis}</dt>
									<dd>{post.data.hypothesis}</dd>
								</>
							)}
							{post.data.plan && (
								<>
									<dt>{labLabels.plan}</dt>
									<dd>{post.data.plan}</dd>
								</>
							)}
							{post.data.preregistered_at && (
								<>
									<dt>{labLabels.preregisteredAt}</dt>
									<dd><time datetime={post.data.preregistered_at.toISOString()}>{formatDate(post.data.preregistered_at, locale)}</time></dd>
								</>
							)}
							<dt>{labLabels.result}</dt>
							<dd>{post.data.result}</dd>
						</dl>
					</aside>
				)}
				<ArticleToc headings={headings} locale={locale} />
				{showAds && <AdSlot slot="top" locale={locale} />}
				<Content />
				<p class="markdown-link" data-pagefind-ignore><a href={`/blog/${post.data.slug}.md`}>Markdown 原文</a></p>
				{post.data.category === 'investing' && <p class="notice">本文為投資方法論的教育性分享，不構成任何個股買賣建議、不提供目標價、不針對當期標的。投資有風險，任何決策請自行判斷或諮詢合格的專業人士。</p>}
			</div>
		</article>
		<VocusLink slug={post.data.slug} />
		{showAds && <AdSlot slot="bottom" locale={locale} />}
		<RelatedPosts posts={related} locale={locale} />
		<Giscus />
	</main>
</SiteLayout>

<style>
	.article-cover {
		margin: 0;
	}

	.article-cover img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		border: 1px solid var(--line);
	}
</style>
