---
import Giscus from '../../components/Giscus.astro';
import ReadMoreGate from '../../components/ReadMoreGate.astro';
import VocusLink from '../../components/VocusLink.astro';
import vocusLinks from '../../data/vocus-links.json';
import vocusStatus from '../../data/vocus-fulltext-status.json';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getBlogPosts } from '../../lib/content';
import { formatDate } from '../../lib/site';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getBlogPosts('zh-TW');
	return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const locale = 'zh-TW';
const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.data.slug}/`;
// 只有真的存在英文版才給網址——寫死會讓語言鈕指到 404
const enPosts = await getBlogPosts('en');
const alternatePath = enPosts.some((p) => p.data.slug === post.data.slug)
	? `/en/blog/${post.data.slug}/`
	: null;
const labLabels = {
	hypothesis: '假設',
	plan: '驗證計畫',
	preregisteredAt: '預註冊時間',
	result: '結果',
};
const hasPreregistration = post.data.category === 'lab' && (post.data.hypothesis || post.data.plan || post.data.preregistered_at || post.data.result);
// 2026-08-31：中文版只放上半部，全文導到方格子（英文版不套用——方格子無英文版）。
// 收合的前提是那句「全文在方格子」為真，所以要兩個條件同時成立：
//   1. 有對應的方格子文章編號
//   2. check-vocus-fulltext.mjs 驗過它還在、且字數不少於本地原文（狀態 ok）
// 任一不成立就給全文——寧可少導一次流量，不可叫讀者去看不存在的全文。
const SALON_URL = 'https://vocus.cc/salon/6a1e9e1a9da94e81ec5c81e6';
const gateArticleId = (vocusLinks as Record<string, string>)[post.data.slug];
const fullTextOk = (vocusStatus as Record<string, string>)[post.data.slug] === 'ok';
const gateArticleUrl = gateArticleId && fullTextOk ? `https://vocus.cc/article/${gateArticleId}` : null;
---

<SiteLayout
	title={post.data.title}
	description={post.data.description}
	locale={locale}
	path={path}
	alternatePath={alternatePath}
	image={post.data.ogImage}
	breadcrumbs={[{ name: '文章', path: '/blog/' }, { name: post.data.title, path }]}
	article={{
		title: post.data.title,
		description: post.data.description,
		summary: post.data.tldr,
		pubDate: post.data.pubDate,
		updatedDate: post.data.updatedDate,
		path,
		tags: post.data.tags,
		image: post.data.ogImage,
	}}
>
	<main class="page article-shell">
		<article>
			<header class="article-header">
				<div class="meta">
					<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time>
					<span>{post.data.category}</span>
				</div>
				<h1 class="article-title">{post.data.title}</h1>
				<p class="lead">{post.data.description}</p>
				<ul class="tag-list">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
			</header>
			<div class="prose">
				{post.data.tldr && (
					<aside class="tldr-panel" aria-labelledby="tldr-title">
						<h2 id="tldr-title">TL;DR</h2>
						<p>{post.data.tldr}</p>
					</aside>
				)}
				{hasPreregistration && (
					<aside class="preregistration-panel" aria-labelledby="preregistration-title">
						<h2 id="preregistration-title">預註冊紀錄</h2>
						<dl>
							{post.data.hypothesis && (
								<>
									<dt>{labLabels.hypothesis}</dt>
									<dd>{post.data.hypothesis}</dd>
								</>
							)}
							{post.data.plan && (
								<>
									<dt>{labLabels.plan}</dt>
									<dd>{post.data.plan}</dd>
								</>
							)}
							{post.data.preregistered_at && (
								<>
									<dt>{labLabels.preregisteredAt}</dt>
									<dd><time datetime={post.data.preregistered_at.toISOString()}>{formatDate(post.data.preregistered_at, locale)}</time></dd>
								</>
							)}
							<dt>{labLabels.result}</dt>
							<dd>{post.data.result}</dd>
						</dl>
					</aside>
				)}
				<ReadMoreGate articleUrl={gateArticleUrl} salonUrl={SALON_URL}>
					<Content />
				</ReadMoreGate>
				{/* Markdown 原文連結會直接給出全文，等於繞過上面的收合——
				    只在沒有方格子版（不收合）的文章保留 */}
				{!gateArticleUrl && (
					<p class="markdown-link"><a href={`/blog/${post.data.slug}.md`}>Markdown 原文</a></p>
				)}
				{post.data.category === 'investing' && <p class="notice">本文為投資方法論的教育性分享，不構成任何個股買賣建議、不提供目標價、不針對當期標的。投資有風險，任何決策請自行判斷或諮詢合格的專業人士。</p>}
			</div>
		</article>
		<VocusLink slug={post.data.slug} />
		<Giscus />
	</main>
</SiteLayout>
