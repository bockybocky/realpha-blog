---
import SiteLayout from '../layouts/SiteLayout.astro';
import VideoFeature from '../components/VideoFeature.astro';
import videos from '../data/videos.json';

const locale = 'zh-TW';
const items = videos
	.filter((video) => video.lang === 'zh-TW')
	.sort((a, b) => b.date.localeCompare(a.date));
---

<SiteLayout title="短影片" description="Realpha 的短影片：一支片子講清楚一件事，再連回完整文章。" locale={locale} path="/videos/" alternatePath="/en/videos/" breadcrumbs={[{ name: '短影片', path: '/videos/' }]}>
	<main class="page article-shell">
		<header class="article-header">
			<h1 class="article-title">短影片</h1>
			<p class="lead">一支片子講一件事。看完想再往下讀，卡片下面有文章連結。</p>
		</header>
		{items.length === 0 ? (
			<p>影片準備中</p>
		) : (
			<ul class="video-list">
				{items.map((video) => (
					<li>
						<VideoFeature video={video} locale={locale} headingLevel="h2" />
					</li>
				))}
			</ul>
		)}
	</main>
</SiteLayout>

<style>
	.video-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2.5rem;
	}
</style>
