---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SeriesGrid from '../../components/SeriesGrid.astro';
import { getCatalog } from '../../lib/catalog';

const { series } = await getCatalog('zh-TW');
---

<SiteLayout title="節目系列" description="依 Podcast 節目整理的收聽心得。" locale="zh-TW" path="/series/" alternatePath="/en/series/" breadcrumbs={[{ name: '節目系列', path: '/series/' }]}>
	<main class="page" data-pagefind-ignore="all">
		<header class="section-header">
			<h1 class="page-title series-title">節目系列</h1>
			<p class="lead">依節目整理的收聽心得，共 {series.length} 個節目。</p>
		</header>
		<SeriesGrid series={series} locale="zh-TW" />
	</main>
</SiteLayout>

<style>
	.series-title { max-width: none; font-size: clamp(2rem, 6vw, 3.4rem); }
</style>
