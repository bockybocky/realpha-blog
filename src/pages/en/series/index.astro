---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SeriesGrid from '../../../components/SeriesGrid.astro';
import { getCatalog } from '../../../lib/catalog';

const { series } = await getCatalog('en');
---

<SiteLayout title="Shows" description="Listening notes grouped by podcast." locale="en" path="/en/series/" alternatePath="/series/" breadcrumbs={[{ name: 'Shows', path: '/en/series/' }]}>
	<main class="page" data-pagefind-ignore="all">
		<header class="section-header">
			<h1 class="page-title series-title">Shows</h1>
			<p class="lead">Listening notes grouped by podcast: {series.length} shows.</p>
		</header>
		<SeriesGrid series={series} locale="en" />
	</main>
</SiteLayout>

<style>
	.series-title { max-width: none; font-size: clamp(2rem, 6vw, 3.4rem); }
</style>
