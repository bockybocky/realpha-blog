---
import AdSlot from '../../../components/AdSlot.astro';
import ArticleToc from '../../../components/ArticleToc.astro';
import AudioPlayer from '../../../components/AudioPlayer.astro';
import { resolveAudio } from '../../../lib/audio';
import Giscus from '../../../components/Giscus.astro';
import RelatedPosts from '../../../components/RelatedPosts.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SubstackLink from '../../../components/SubstackLink.astro';
import { coverAlt, readingMinutes, relatedPosts } from '../../../lib/article-extras';
import topicsData from '../../../data/topics.json';
import { getBlogPosts } from '../../../lib/content';
import { viewsOf } from '../../../lib/popular';
import { formatDate } from '../../../lib/site';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getBlogPosts('en');
	return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post, posts } }));
}

const locale = 'en';
const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const path = `/en/blog/${post.data.slug}/`;
const alternatePath = `/blog/${post.data.slug}/`;
const labLabels = {
	hypothesis: 'Hypothesis',
	plan: 'Validation plan',
	preregisteredAt: 'Preregistered at',
	result: 'Result',
};
const hasPreregistration = post.data.category === 'lab' && (post.data.hypothesis || post.data.plan || post.data.preregistered_at || post.data.result);

const minutes = readingMinutes(post.body ?? '', locale);
const pubText = formatDate(post.data.pubDate, locale);
const updatedText = post.data.updatedDate ? formatDate(post.data.updatedDate, locale) : null;
const showAds = post.data.category !== 'lab';
const related = relatedPosts(post, posts, 6, new Set(topicsData.series.map((s) => s.id)));
// Cover moves under the title; the body already embeds the same image at the top, so hide that copy.
const cover = post.data.cover;
const hideBodyCover = Boolean(cover && post.body?.includes(cover));
const hideCoverCss = hideBodyCover
	? `<style>.prose img[src=${JSON.stringify(cover)}]{display:none}.prose p:has(> img[src=${JSON.stringify(cover)}]:only-child){display:none}</style>`
	: '';
// English pages only get English audio (<slug>.en.mp3); resolveAudio keys by lang
const audio = resolveAudio(post.data);
// Cumulative human views (local logs since 2026-08-19, bots filtered); hidden when 0
const views = viewsOf('en', post.data.slug);
---

<SiteLayout
	title={post.data.title}
	description={post.data.description}
	locale={locale}
	path={path}
	alternatePath={alternatePath}
	image={post.data.ogImage}
	breadcrumbs={[{ name: 'Blog', path: '/en/blog/' }, { name: post.data.title, path }]}
	article={{
		title: post.data.title,
		description: post.data.description,
		summary: post.data.tldr,
		pubDate: post.data.pubDate,
		updatedDate: post.data.updatedDate,
		path,
		tags: post.data.tags,
		image: post.data.ogImage,
	}}
>
	<Fragment set:html={hideCoverCss} />
	<main class="page article-shell">
		<article data-pagefind-body>
			<header class="article-header">
				<div class="meta">
					<time datetime={post.data.pubDate.toISOString()}>{pubText}</time>
					<span>{minutes} min read</span>
					{views > 0 && <span class="views">{views.toLocaleString('en-US')} {views === 1 ? 'view' : 'views'}</span>}
					<span>{post.data.category}</span>
					{updatedText && updatedText !== pubText && (
						<span>Updated: <time datetime={post.data.updatedDate!.toISOString()}>{updatedText}</time></span>
					)}
				</div>
				<h1 class="article-title">{post.data.title}</h1>
				{audio && <AudioPlayer audio={audio} locale={locale} />}
				{cover && (
					<figure class="article-cover">
						<img src={cover} alt={coverAlt(post.body ?? '', cover, post.data.title)} width="1600" height="900" decoding="async" fetchpriority="high" />
					</figure>
				)}
				<p class="lead">{post.data.description}</p>
				<ul class="tag-list">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
			</header>
			<div class="prose">
				{post.data.tldr && (
					<aside class="tldr-panel" aria-labelledby="tldr-title">
						<h2 id="tldr-title">TL;DR</h2>
						<p>{post.data.tldr}</p>
					</aside>
				)}
				{hasPreregistration && (
					<aside class="preregistration-panel" aria-labelledby="preregistration-title">
						<h2 id="preregistration-title">Preregistration Record</h2>
						<dl>
							{post.data.hypothesis && (
								<>
									<dt>{labLabels.hypothesis}</dt>
									<dd>{post.data.hypothesis}</dd>
								</>
							)}
							{post.data.plan && (
								<>
									<dt>{labLabels.plan}</dt>
									<dd>{post.data.plan}</dd>
								</>
							)}
							{post.data.preregistered_at && (
								<>
									<dt>{labLabels.preregisteredAt}</dt>
									<dd><time datetime={post.data.preregistered_at.toISOString()}>{formatDate(post.data.preregistered_at, locale)}</time></dd>
								</>
							)}
							<dt>{labLabels.result}</dt>
							<dd>{post.data.result}</dd>
						</dl>
					</aside>
				)}
				<ArticleToc headings={headings} locale={locale} />
				{showAds && <AdSlot slot="top" locale={locale} />}
				<Content />
				<p class="markdown-link" data-pagefind-ignore><a href={`/en/blog/${post.data.slug}.md`}>Raw Markdown</a></p>
				{post.data.category === 'investing' && <p class="notice">This article is an educational discussion of investment method. It is not advice to buy or sell any individual security, offers no target prices, and does not analyze any current holding. Investing carries risk; make your own decisions or consult a qualified professional.</p>}
			</div>
		</article>
		<SubstackLink slug={post.data.slug} />
		{showAds && <AdSlot slot="bottom" locale={locale} />}
		<RelatedPosts posts={related} locale={locale} />
		<Giscus />
	</main>
</SiteLayout>

<style>
	.article-cover {
		margin: 0;
	}

	.article-cover img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		border: 1px solid var(--line);
	}
</style>
