---
import SiteLayout from '../../layouts/SiteLayout.astro';
import VideoFeature from '../../components/VideoFeature.astro';
import videos from '../../data/videos.json';

const locale = 'en';
const items = videos
	.filter((video) => video.lang === 'en')
	.sort((a, b) => b.date.localeCompare(a.date));
---

<SiteLayout title="Videos" description="Short Realpha videos: one idea per clip, with a link back to the full article." locale={locale} path="/en/videos/" alternatePath="/videos/" breadcrumbs={[{ name: 'Videos', path: '/en/videos/' }]}>
	<main class="page article-shell">
		<header class="article-header">
			<h1 class="article-title">Videos</h1>
			<p class="lead">One clip, one idea. The card below each video links to the full article.</p>
		</header>
		{items.length === 0 ? (
			<p>Videos are on the way.</p>
		) : (
			<ul class="video-list">
				{items.map((video) => (
					<li>
						<VideoFeature video={video} locale={locale} headingLevel="h2" />
					</li>
				))}
			</ul>
		)}
	</main>
</SiteLayout>

<style>
	.video-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2.5rem;
	}
</style>
