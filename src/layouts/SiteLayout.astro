---
import '../styles/global.css';
import { absoluteUrl, localeBar, localeMeta, site, withLocale, type Locale } from '../lib/site';
import topicsData from '../data/topics.json';
import AdSenseHead from '../components/AdSenseHead.astro';

type Breadcrumb = { name: string; path: string };
type ArticleData = {
	title: string;
	description: string;
	summary?: string;
	pubDate: Date;
	updatedDate?: Date;
	path: string;
	tags: string[];
	image?: string;
};

interface Props {
	title: string;
	description: string;
	locale: Locale;
	path: string;
	/** 另一語言版本的網址；沒有對應版本時傳 null——不顯示切換鈕，也不輸出 hreflang */
	alternatePath: string | null;
	breadcrumbs?: Breadcrumb[];
	article?: ArticleData;
	image?: string;
	/** 不給搜尋引擎收錄（離線頁用） */
	noindex?: boolean;
	/** 只對 Google 不收錄（節目心得頁，2026-09-22）；Bing 與其他爬蟲照收。中英兩版由呼叫端算好同進退 */
	googleNoindex?: boolean;
}

const { title, description, locale, path, alternatePath, breadcrumbs = [], article, image = site.ogImage, noindex = false, googleNoindex = false } = Astro.props;
const meta = localeMeta[locale];
const titleText = title === site.name ? title : `${title} | ${site.name}`;
const canonical = absoluteUrl(path);
const zhPath = locale === 'zh-TW' ? path : alternatePath;
const enPath = locale === 'en' ? path : alternatePath;
const hasAlternate = Boolean(alternatePath);
// 頁面最上方的語言列：每個語系有這一頁才畫（2026-09-23 Charles）。加語系＝site.ts 的 localeBar 加一筆＋這裡給網址。
const localePaths: Partial<Record<Locale, string | undefined>> = { 'zh-TW': zhPath, en: enPath };
const langItems = localeBar
	.map((item) => ({ ...item, href: localePaths[item.code], current: item.code === locale }))
	.filter((item) => item.current || item.href);
const graph = [
	{
		'@type': 'Organization',
		'@id': absoluteUrl('/#organization'),
		name: site.org,
		url: absoluteUrl('/'),
		logo: absoluteUrl(site.ogImage),
	},
	{
		'@type': 'Person',
		'@id': absoluteUrl('/#bocky'),
		name: site.author,
		url: site.github,
		affiliation: { '@id': absoluteUrl('/#organization') },
	},
	{
		'@type': 'BreadcrumbList',
		itemListElement: [{ name: meta.home, path: withLocale(locale, '/') }, ...breadcrumbs].map((crumb, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: crumb.name,
			item: absoluteUrl(crumb.path),
		})),
	},
];
if (article) {
	graph.push({
		'@type': 'Article',
		'@id': absoluteUrl(article.path),
		headline: article.title,
		description: article.description,
		abstract: article.summary ?? article.description,
		datePublished: article.pubDate.toISOString(),
		dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
		mainEntityOfPage: absoluteUrl(article.path),
		image: absoluteUrl(article.image ?? site.ogImage),
		keywords: article.tags,
		author: { '@id': absoluteUrl('/#bocky') },
		publisher: { '@id': absoluteUrl('/#organization') },
	});
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const homeHref = withLocale(locale, '/');
// 主題導向導覽：首頁｜三個主題（心法與成長／研究筆記／投資與市場）｜關於（2026-09-15 依 Charles 拿掉節目系列與驗證簿）
const nav = [
	{ href: homeHref, label: meta.home },
	...topicsData.topics
		.filter((topic) => topic.id !== 'lab')
		.map((topic) => ({ href: withLocale(locale, `/topics/${topic.id}/`), label: topic.nav[locale] })),
	// 週報排在「投資與市場」後面（2026-09-23 Charles）
	{ href: withLocale(locale, '/weekly/'), label: meta.weeklyNav },
	{ href: withLocale(locale, '/about/'), label: meta.aboutNav },
];
const isCurrent = (href: string) => path === href || (href !== homeHref && path.startsWith(href));
const searchHref = withLocale(locale, '/search/');
// 提案／Lab／方法論／作品移到頁尾
const footerNav = [
	{ href: withLocale(locale, '/lab/'), label: meta.lab },
	{ href: withLocale(locale, '/projects/'), label: meta.projects },
	{ href: withLocale(locale, '/blog/'), label: meta.blog },
	{ href: '/privacy/', label: meta.privacy },
	{ href: withLocale(locale, '/app/'), label: meta.app },
];
---

<!doctype html>
<html lang={meta.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{titleText}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		{googleNoindex && !noindex && <meta name="googlebot" content="noindex" />}
		<link rel="canonical" href={canonical} />
		{zhPath && <link rel="alternate" hreflang="zh-TW" href={absoluteUrl(zhPath)} />}
		{enPath && <link rel="alternate" hreflang="en" href={absoluteUrl(enPath)} />}
		{zhPath && <link rel="alternate" hreflang="x-default" href={absoluteUrl(zhPath)} />}
		<link rel="alternate" type="application/rss+xml" title={`${site.name} ${meta.rssLabel}`} href={withLocale(locale, '/rss.xml')} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<!-- PWA：可安裝的網頁 app（2026-09-15） -->
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content="#f6f5f1" />
		<meta name="color-scheme" content="light" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="Realpha" />
		<script is:inline>
			if ('serviceWorker' in navigator && window.isSecureContext) {
				window.addEventListener('load', function () {
					navigator.serviceWorker.register('/sw.js').catch(function () {});
				});
			}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=LXGW+WenKai+TC:wght@400;700&display=swap" />
		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={titleText} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={absoluteUrl(image)} />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" set:html={jsonLd}></script>
		<AdSenseHead />
	</head>
	<body>
		<div class="lang-bar" data-pagefind-ignore="all">
			<nav class="lang-bar-inner" aria-label={locale === 'zh-TW' ? '語言' : 'Language'}>
				{langItems.map((item) => (item.current
					? <span class="lang-pill is-current" aria-current="true">{item.short}</span>
					: <a class="lang-pill" href={item.href} hreflang={item.code}>{item.short}</a>))}
			</nav>
		</div>
		<header class="site-header" data-pagefind-ignore="all">
			<nav class="nav" aria-label="Primary">
				<a class="brand" href={withLocale(locale, '/')} aria-label="Realpha Blog">
					<img src="/brand/logo-lockup-lighttheme.svg" alt="Realpha" width="640" height="150" class="brand-logo" />
					<span class="brand-suffix">Blog</span>
				</a>
				<div class="nav-links">
					{nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
					<a class="nav-search" href={searchHref} aria-label={meta.search} title={meta.search} aria-current={path === searchHref ? 'page' : undefined}>
						<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
					</a>
				</div>
			</nav>
		</header>
		<slot />
		<footer class="site-footer" data-pagefind-ignore="all">
			<div class="footer-inner">
				<p>Articles CC BY-NC-SA 4.0. Code MIT.</p>
				<nav aria-label="Footer">
					{footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
					<a href={withLocale(locale, '/rss.xml')}>RSS</a>
					<a href={site.github}>GitHub</a>
					<a href="/llms.txt">llms.txt</a>
				</nav>
			</div>
		</footer>
		<script src="/copy-code.js" defer></script>
	</body>
</html>
